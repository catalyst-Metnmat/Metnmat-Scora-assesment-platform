# ─── SCORA (by METNMAT Innovations) — environment variables ───
# Copy this file to ".env" for local use, or set these in your host's dashboard.

# MongoDB Atlas connection string. Leave EMPTY to use local file storage (dev only).
# Get it from Atlas → Database → Connect → Drivers. Replace <db_password> with your DB user password.
MONGODB_URI=mongodb+srv://metnmat:<db_password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0

# Database name (optional, default: metnmat_assessment)
MONGODB_DB=metnmat_assessment

# Shared access keys (bootstrap / fallback). REQUIRED in production
# (otherwise auto-generated and printed in logs). Named user accounts created
# in-app are the preferred sign-in; these keys always keep working as a fallback.
# Generate strong ones with:  node -e "console.log(require('crypto').randomBytes(12).toString('base64url'))"
ADMIN_KEY=
HR_KEY=

# Secret used to sign named-user login tokens (JWT/HS256). Optional —
# auto-generated and stored if omitted. Set it to keep tokens valid across redeploys.
JWT_SECRET=

# ─── Email (Resend) ───
# Sends each employee their SCORA code on registration, plus assessment notices.
# Leave RESEND_API_KEY empty to disable email (the app still works; no mail is sent).
# Get a key at https://resend.com → API Keys. The sending domain (metnmat.com) must
# be verified in Resend for delivery. MAIL_FROM must use that verified domain.
RESEND_API_KEY=
MAIL_FROM=METNMAT Assessment <noreply@metnmat.com>

# Public base URL of this site (used to build the login link in emails).
# Optional locally; set it in production, e.g. https://scora.onrender.com
PUBLIC_URL=

# Port (local only; hosts set this automatically)
PORT=3010
